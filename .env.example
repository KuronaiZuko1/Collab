# ==============================================================================
# BANDI — Local-First Automated Trading Intelligence & Alert Engine
# Configuration Settings Template
# ==============================================================================

# Application Settings
APP_NAME=BANDI
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8000

# SQLite Database
DATABASE_PATH=data/bandi.db

# Timezone (Display in Africa/Johannesburg - SAST UTC+2; internal storage is strictly UTC)
DISPLAY_TIMEZONE=Africa/Johannesburg

# ------------------------------------------------------------------------------
# Telegram Bot Configuration
# ------------------------------------------------------------------------------
# Obtain bot token from @BotFather and your personal chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=true

# ------------------------------------------------------------------------------
# Economic News Calendar Engine
# ------------------------------------------------------------------------------
CALENDAR_API_URL=https://showmytrades.com/api/public/calendar/v1
CALENDAR_POLL_INTERVAL_MINUTES=15
CALENDAR_RANGE_DAYS=7

# Scheduler alert triggers
ALERT_MINUTES_BEFORE=30
LATE_ALERT_WINDOW_MINUTES=25
SCHEDULER_CHECK_INTERVAL_SECONDS=15

# ------------------------------------------------------------------------------
# MetaTrader 5 Integration
# ------------------------------------------------------------------------------
MT5_ENABLED=true
MT5_TERMINAL_PATH=C:\Program Files\JustMarkets MetaTrader 5\terminal64.exe
MT5_METAEDITOR_PATH=C:\Program Files\JustMarkets MetaTrader 5\MetaEditor64.exe
MT5_DEMO_MODE=true

# ------------------------------------------------------------------------------
# Trading Mode & Safety Execution Control
# Modes: OFF | SIGNALS_ONLY | APPROVAL | AUTO
# Default is OFF. Live order execution requires RISK_TRADING_LOCKED=false and
# LIVE_TRADING_CONFIRMED=true if not in demo mode.
# ------------------------------------------------------------------------------
TRADING_MODE=OFF
RISK_TRADING_LOCKED=true
LIVE_TRADING_CONFIRMED=false

# ------------------------------------------------------------------------------
# Deterministic Risk Management Parameters (Hard Limits)
# ------------------------------------------------------------------------------
RISK_PER_TRADE_PCT=1.0
MAX_LOT=1.0
MIN_RR=1.5
RISK_MAX_DAILY_DRAWDOWN_PCT=3.0
WEEKLY_LOSS_LIMIT_PCT=6.0
MAX_CONSECUTIVE_LOSSES=3
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_SPREAD_POINTS=30
MAX_TRADES_PER_DAY=3
MAX_CORRELATED_USD_POSITIONS=2

# ------------------------------------------------------------------------------
# Strategy, Filters & Session Restrictions
# ------------------------------------------------------------------------------
NEWS_BLACKOUT_BEFORE_MIN=30
NEWS_BLACKOUT_AFTER_MIN=15
ALLOWED_SESSIONS=London,New York
SIGNAL_EXPIRY_MIN=120
MAGIC_NUMBER=202611
ATR_PERIOD=14
STRATEGY_TIMEFRAMES=M15,H1,H4,D1

# ------------------------------------------------------------------------------
# GitHub Repository (Automated Backup & Synchronization)
# ------------------------------------------------------------------------------
GITHUB_REPO=https://github.com/KuronaiZuko1/Collab.git
GITHUB_ACCESS_TOKEN=your_personal_access_token_here
